<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smartpantrymanager">

    <application
        android:allowBackup="true"
        android:label="Smart Pantry Manager"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <activity
            android:name="com.example.smartpantrymanager.PantryListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.smartpantrymanager.AddEditIngredientActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantrymanager.SuggestedRecipesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantrymanager.RecipeDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.example.smartpantrymanager.SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
